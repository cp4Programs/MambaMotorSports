# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data: omit or "local" for .data/store.json; "amplify" after sandbox/deploy
DATA_BACKEND=local

# Owner demo login (local only)
OWNER_DEMO_PASSWORD=mamba-owner
OWNER_DEV_TOKEN=local-owner-token

# Cognito (filled from amplify_outputs after `npx ampx sandbox` / Amplify Hosting)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-west-2

# Email — set EMAIL_MODE=log to print instead of SES
EMAIL_MODE=log
SES_FROM_EMAIL=
SHOP_NOTIFY_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
