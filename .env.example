# Public site URL (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Owner dashboard credentials (replace in Amplify console for production)
OWNER_EMAIL=owner@mambamotorsports.com
OWNER_PASSWORD=change-me-strong-password
OWNER_SESSION_SECRET=replace-with-long-random-string

# Notifications (Amazon SES)
NOTIFY_EMAIL=jorge@example.com
SES_FROM_EMAIL=noreply@yourdomain.com
AWS_REGION=us-west-2

# Stripe (optional in local dev — without keys, Pay is disabled unless
# ALLOW_DEV_PAYMENTS=true below). Never enable dev payments in production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local-only convenience: settle invoices without Stripe keys. Leave unset in prod.
ALLOW_DEV_PAYMENTS=false
